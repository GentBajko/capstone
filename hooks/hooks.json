{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}\"/skills/core/scripts/init-config.sh --global"
          }
        ]
      }
    ],
    "UserPromptExpansion": [
      {
        "matcher": "capstone:help",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}\"/skills/core/scripts/help-hook.sh"
          }
        ]
      }
    ]
  }
}
